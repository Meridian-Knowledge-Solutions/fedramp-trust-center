{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meridian-knowledge-solutions.github.io/fedramp-trust-center/api/v1/manifest.schema.json",
  "title": "FedRAMP Certification Package manifest",
  "description": "Index of the machine-readable FedRAMP Certification Package artifacts served by the Meridian Trust Center (CDS-CSX-API groundwork, CDS-TRC-PAC). Generated by scripts/generate_package_manifest.py from config/package_manifest_catalog.json.",
  "type": "object",
  "required": [
    "manifest_version",
    "package_version",
    "sequence",
    "generated_at",
    "provider",
    "fedramp_id",
    "base_url",
    "stable_paths",
    "artifacts"
  ],
  "properties": {
    "manifest_version": {
      "type": "string",
      "description": "Contract version. Bumped on any path rename or field removal."
    },
    "schema": {
      "type": "string",
      "format": "uri"
    },
    "package_version": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}\\.\\d+$",
      "description": "YYYY.MM.DD.<sequence>"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic publish counter (one per manifest-history.jsonl line)."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider": {
      "type": "string"
    },
    "cso_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "fedramp_id": {
      "type": "string",
      "pattern": "^FR[0-9A-Z]+$"
    },
    "base_url": {
      "type": "string",
      "format": "uri"
    },
    "transport": {
      "type": "string"
    },
    "stable_paths": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "format": "uri"
      }
    },
    "versioning": {
      "type": "object"
    },
    "categories": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "artifact_count": {
      "type": "integer"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "cadence": {
            "type": "string"
          },
          "producer": {
            "type": "string"
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "path": {
            "type": "string"
          },
          "url_path": {
            "type": "string",
            "pattern": "^/"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "external_url": {
            "type": "string",
            "format": "uri"
          },
          "index_url": {
            "type": "string",
            "format": "uri"
          },
          "status": {
            "type": "string",
            "enum": [
              "missing",
              "external"
            ]
          },
          "media_type": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "last_modified": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "generated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "changed_since_previous": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "schema": {
            "$ref": "#/$defs/related"
          },
          "human_readable": {
            "$ref": "#/$defs/related"
          }
        }
      }
    },
    "schemas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "url",
          "sha256"
        ]
      }
    },
    "policies": {
      "type": "object",
      "required": [
        "count",
        "index_url"
      ]
    },
    "ksi_run_history": {
      "type": [
        "object",
        "null"
      ]
    },
    "additional_distribution": {
      "type": "array"
    },
    "uncatalogued": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "url",
          "sha256"
        ]
      }
    },
    "missing_catalogued_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deprecated": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "url",
          "sha256",
          "replacement"
        ]
      }
    }
  },
  "$defs": {
    "related": {
      "type": "object",
      "required": [
        "path",
        "url",
        "present"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "present": {
          "type": "boolean"
        }
      }
    }
  }
}
